---
import { Image } from 'astro:assets'

import Toggler from '@/common/ui/components/toggler/toggler.svelte'
---

<header class='w-full bg-white text-slate-900 transition-colors duration-700 dark:bg-black dark:text-white'>
  <div class='content-width flex flex-col items-start gap-5 px-4 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-6 lg:px-12'>
  <a class='group inline-group no-underline' href='/' aria-label='036astro'>
    <span
      class='grid size-11 place-items-center rounded-2xl accent-bg accent-shadow transition duration-300 group-hover:rotate-6 group-hover:scale-105'
    >
     <Image src="/astro-white.svg" alt="036astro" width="25" height="25" />
    </span>
    <span class='display-font text-lg font-bold text-xl tracking-normal text-slate-900 no-underline dark:text-white'>
      036astro
    </span>
  </a>
  	<Toggler client:load />
  </div>
</header>
