---
import { ClientRouter } from 'astro:transitions'
import Head from '@/common/ui/components/head/Head.astro'
import Header from '@/common/ui/components/header/Header.astro'

export type Props = { title: string }

const { title } = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <Head title={title} />
    <ClientRouter />
  </head>
  <body>
    <main class='app flex min-h-screen flex-col transition-colors duration-1000'>
      <Header />
      <slot />
    </main>
    <script>
      import { script } from './layout'
      script()
    </script>
  </body>
  <style is:global>
    :root {
      --accent: #6603fc;
      --accent-alt: #9c1c85;
      --accent-soft: #9361ff;
      --store-input-text: #0f172a;
    }

    :root.dark {
      --store-input-text: #fff;
    }

    :root[data-accent='magenta'] {
      --accent: #9c1c85;
      --accent-alt: #6603fc;
      --accent-soft: #c04eaa;
    }

    :root[data-accent='teal'] {
      --accent: #1c959c;
      --accent-alt: #6603fc;
      --accent-soft: #43c5c5;
    }

    .accent-bg {
      background-color: var(--accent) !important;
    }

    .accent-text {
      color: var(--accent) !important;
    }

    .accent-gradient {
      background-image: linear-gradient(135deg, var(--accent-alt), var(--accent));
    }

    .accent-shadow {
      box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--accent) 30%, transparent) !important;
    }

    .accent-link:hover {
      color: var(--accent-soft) !important;
    }

    .store-form-input {
      color: var(--store-input-text) !important;
    }

    .primary-button {
      background-color: var(--accent) !important;
    }

    .primary-button:hover {
      background-color: var(--accent-alt) !important;
    }

    .color-button-selected {
      box-shadow: 0 25px 50px -12px color-mix(in srgb, var(--accent) 75%, transparent) !important;
    }

    .theme-toggle-active {
      background-color: var(--accent) !important;
    }
  </style>
</html>
