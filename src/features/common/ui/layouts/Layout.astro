---
import { ClientRouter } from 'astro:transitions'
import Head from '@/common/ui/components/head/Head.astro'

const { title } = Astro.props

export type Props = { title: string }
---

<!doctype html>
<html lang='en'>
  <head>
    <Head title={title} />
    <ClientRouter />
  </head>
  <body>
    <main class='app flex min-h-screen flex-col transition-colors duration-1000'>
      <slot />
    </main>
  </body>
</html>
