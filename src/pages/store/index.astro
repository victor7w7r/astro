---
import Layout from '@/common/ui/layouts/Layout.astro'
---

<Layout title='Store Page'>
  <div class='flex flex-1 items-center justify-center bg-white px-4 py-8 text-slate-900 transition-colors duration-700 dark:bg-black dark:text-white sm:px-6'>
    <section class='glass-panel w-full max-w-xl p-6 accent-shadow sm:p-10'>
      <div class='mt-2'>
        <h1 class='display-font mt-3 text-5xl leading-none tracking-tight sm:text-6xl'>
          Leave a trace.
        </h1>
        <p class='mt-5 max-w-md text-sm leading-6 text-slate-600 dark:text-white/60 sm:text-base'>
          Write something small and keep it in the local store. It stays in this
          browser, ready whenever you come back.
        </p>
      </div>
      <store-form></store-form>
      <div class='mt-2 border-t border-slate-200 pt-5 dark:border-white/10'>
        <a class='accent-link text-sm font-bold text-slate-600 no-underline transition dark:text-white/60' href='/' rel='prefetch'>
          ← Back to home
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { script } from '@/store/ui/scripts'
  script()
</script>
